# Dependencies and build output (recreated inside the image)
node_modules
.next
.next-ingress
.next-ingress-run
out
build
coverage
tsconfig.tsbuildinfo

# VCS / CI / agent metadata
.git
.github
.agent

# Tests and tooling not needed for the production build.
# scripts/ bleibt im Kontext: das Runtime-Image kopiert daraus den
# Start-Einstieg (start.mjs, base-path.mjs, ingress-proxy.mjs).
e2e
tests
playwright-report
test-results
blob-report

# Environment files — provide configuration at runtime instead
.env*

# Root-level docs only. Patterns without "/" match at the context root, so
# data/docs/*.md (seed content needed in the runner stage) stays included.
*.md

# Never bake secrets or per-user runtime data into the image.
# data/ itself must stay in the build context (seed data for the runner).
data/secure

# Docker build files themselves
Dockerfile
.dockerignore
