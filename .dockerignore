# Dependencies and build output (recreated inside the image)
node_modules
.next
.next-ingress
.next-ingress-run
out
build
coverage
tsconfig.tsbuildinfo

# VCS / CI / agent metadata
.git
.github
.agent

# Tests and tooling not needed for the production build.
# scripts/ bleibt im Kontext: das Runtime-Image kopiert daraus den
# Start-Einstieg (start.mjs, base-path.mjs, ingress-proxy.mjs).
e2e
tests
playwright-report
test-results
blob-report

# Environment files — provide configuration at runtime instead
.env*

# Root-level docs only. Patterns without "/" match at the context root, so
# seed/docs/*.md (delivery content needed in the runner stage) stays included.
*.md

# Instance state never enters the image (issue #32): the build context is
# somebody's working directory, and data/ there is their graph, their chat
# history, their keys. Delivery content lives in seed/.
data

# Docker build files themselves
Dockerfile
.dockerignore
