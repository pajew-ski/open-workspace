@prefix ow:      <https://pajew-ski.github.io/open-workspace/ns/v1#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix schema:  <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix void:    <http://rdfs.org/ns/void#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontologie-Kopf
#
# Die Vokabular-Base ist produktweit konstant und wandert mit dem
# Code, nicht mit dem Deployment (SPEC §3.2). Deployment-spezifische
# Terme entstehen ausschließlich unter <deploymentBase>/ns/ext#.
#################################################################

<https://pajew-ski.github.io/open-workspace/ns/v1>
    a owl:Ontology ;
    rdfs:label "Open Workspace Vokabular"@de, "Open Workspace Vocabulary"@en ;
    rdfs:comment "Produktvokabular von Open Workspace. Enthält nur Terme, für die nachweislich kein etablierter Standard-Term existiert; alles andere nutzt schema.org, Dublin Core, PROV, FOAF, SKOS. /ns/v1# ist nach Veröffentlichung eingefroren; Breaking Changes ergeben /ns/v2# mit owl:equivalentClass-Brücken."@de ;
    owl:versionInfo "1.0.0-draft" ;
    dcterms:created "2026-08-08"^^xsd:date ;
    dcterms:license <https://opensource.org/licenses/MIT> .

#################################################################
# Klassen
#################################################################

ow:Document a owl:Class ;
    rdfs:subClassOf schema:DigitalDocument ;
    rdfs:label "Dokument"@de, "Document"@en ;
    rdfs:comment "Markierungsklasse für native Workspace-Dokumente. schema:DigitalDocument trägt die Semantik; die Unterklasse existiert, weil Workspace-Dokumente zusätzliche Garantien haben (stabile ID, Markdown-Quelle, Wikilink-Auflösung), die abfragbar sein müssen, ohne alle DigitalDocuments fremder Quellen zu treffen."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:Project a owl:Class ;
    rdfs:subClassOf schema:Project ;
    rdfs:label "Projekt"@de, "Project"@en ;
    rdfs:comment "Markierungsklasse für native Workspace-Projekte, analog ow:Document: unterscheidet eigene Projekte von importierten schema:Project-Knoten fremder Quellen."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:Task a owl:Class ;
    rdfs:subClassOf schema:Action ;
    rdfs:label "Aufgabe"@de, "Task"@en ;
    rdfs:comment "Aufgabe im Workspace. schema.org kennt keine Task-Klasse mit Abhängigkeiten und Projektzuordnung; schema:Action ist die nächstliegende Oberklasse und trägt actionStatus/endTime."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:Canvas a owl:Class ;
    rdfs:subClassOf schema:CreativeWork ;
    rdfs:label "Canvas"@de, "Canvas"@en ;
    rdfs:comment "Manuell kuratierter Subgraph-View: eine Auswahl semantischer Knoten plus räumlicher Anordnung (Layout in graph/presentation, nie hier). Kein Standard-Vokabular modelliert einen gespeicherten Graph-View als eigenständiges Werk."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:Skill a owl:Class ;
    rdfs:subClassOf schema:HowTo ;
    rdfs:label "Skill"@de, "Skill"@en ;
    rdfs:comment "Prozedurales Wissen für AI-Agenten nach der SKILL.md-Konvention (Trigger + Anleitung + Progressive Disclosure). schema:HowTo deckt die Anleitungs-Semantik, aber nicht Trigger und Werkzeugbedarf ab."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:Agent a owl:Class ;
    rdfs:subClassOf foaf:Agent ;
    rdfs:label "Agent"@de, "Agent"@en ;
    rdfs:comment "AI-Agent mit A2A-Agent-Card (Endpoints, Security-Schemes, Skills). foaf:Agent und schema:SoftwareApplication tragen die Grundsemantik; die Unterklasse bündelt die A2A-spezifischen Prädikate, für die kein Standard existiert."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:Tool a owl:Class ;
    rdfs:subClassOf schema:Intangible ;
    rdfs:label "Werkzeug"@de, "Tool"@en ;
    rdfs:comment "Aufrufbares Werkzeug eines Agenten (MCP-Tool, API-Tool) mit JSON-Schema-Eingabe. Kein Standard-Vokabular modelliert LLM-aufrufbare Funktionen; schema:SoftwareApplication beschreibt Anwendungen, nicht einzelne Aufrufflächen."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:ToolProvider a owl:Class ;
    rdfs:subClassOf schema:SoftwareApplication ;
    rdfs:label "Werkzeug-Anbieter"@de, "Tool Provider"@en ;
    rdfs:comment "System, das Werkzeuge bereitstellt, typischerweise ein MCP-Server mit Endpoint und Transport. Die Unterklasse existiert, weil ein MCP-Server über ow:providedBy als Quelle einzelner Tools abfragbar sein muss."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:Connector a owl:Class ;
    rdfs:subClassOf prov:SoftwareAgent ;
    rdfs:label "Connector"@de, "Connector"@en ;
    rdfs:comment "Konfigurierte Instanz des Connector-Frameworks: materialisiert oder föderiert eine externe Wissensquelle. prov:SoftwareAgent macht sie PROV-attributierbar (prov:wasAttributedTo); Art, Quelle und Sync-Zustand haben kein Standard-Äquivalent."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:FederatedEndpoint a owl:Class ;
    rdfs:subClassOf schema:Service ;
    rdfs:label "Föderierter Endpoint"@de, "Federated Endpoint"@en ;
    rdfs:comment "Registrierter externer SPARQL-Endpoint für SERVICE-Queries, mit Vertrauensstufe. void:Dataset beschreibt Datensätze, nicht die Föderationsbeziehung samt Trust-Level; ein void:Dataset-Zusatztyp ist optional."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:InferenceProvider a owl:Class ;
    rdfs:subClassOf schema:Service ;
    rdfs:label "Inference-Provider"@de, "Inference Provider"@en ;
    rdfs:comment "Konfigurierte Inferenz-Quelle dieser Installation (lokale Engine, Cloud-API oder die In-Browser-Laufzeit WebLLM). schema:Service trägt die Dienst-Semantik, kennt aber weder Katalog-Art noch Tool-Aufruf-Verfahren; ow:ToolProvider meint MCP-Server, also Werkzeuge statt Modelle."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:Model a owl:Class ;
    rdfs:subClassOf schema:SoftwareApplication ;
    rdfs:label "Modell"@de, "Model"@en ;
    rdfs:comment "Konfiguriertes Sprachmodell hinter einem Inference-Provider, adressiert über seinen Modellnamen. Kein Standard-Vokabular kennt eine Klasse für Sprachmodelle; schema:SoftwareApplication ist die nächstliegende Oberklasse, weil ein Modell ausführbare Software ist."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# Dokument- und Wissensvernetzung
#################################################################

ow:linksTo a owl:ObjectProperty ;
    rdfs:subPropertyOf schema:mentions ;
    rdfs:label "verlinkt auf"@de, "links to"@en ;
    rdfs:comment "Untypisierter Wikilink ([[Ziel]]) zwischen Knoten. schema:mentions ist die nächstliegende Oberkategorie, trägt aber die Erwähnungs-Semantik von Publikationen; ow:linksTo hält die Herkunft aus expliziter Nutzer-Verlinkung abfragbar getrennt."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:inFolder a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "im Ordner"@de, "in folder"@en ;
    rdfs:comment "Vault-Ordnerpfad als Konvention (z. B. 'projekte/2026'), ohne erzwungene Hierarchie-Semantik. Kein Standard-Term trägt einen Dateisystem-Pfad als bloße Einsortierung ohne Teil-Ganzes-Behauptung."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:embedded a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "eingebettet"@de, "embedded"@en ;
    rdfs:comment "Kanten-Annotation (RDF 1.2, am Reifier eines ow:linksTo-Tripels): true, wenn der Link in der Quelle eine Einbettung/Transklusion war (Obsidian ![[…]]) statt eines bloßen Verweises. Kein Standard-Term unterscheidet Verweis von Transklusion auf Kanten-Ebene; schema:hasPart würde eine Teil-Ganzes-Behauptung über die Dokumente selbst aufstellen statt über die eine Link-Stelle."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# Aufgaben
#################################################################

ow:blockedBy a owl:ObjectProperty ;
    owl:inverseOf ow:blocks ;
    rdfs:domain schema:Action ;
    rdfs:range schema:Action ;
    rdfs:label "blockiert durch"@de, "blocked by"@en ;
    rdfs:comment "Die Aufgabe kann erst beginnen/abschließen, wenn die referenzierte Aufgabe abgeschlossen ist. schema.org kennt keine Aktions-Abhängigkeiten; das improvisierte dependencies-Array der Altfassung wird hiermit durch ein dereferenzierbares Prädikat ersetzt."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:blocks a owl:ObjectProperty ;
    owl:inverseOf ow:blockedBy ;
    rdfs:domain schema:Action ;
    rdfs:range schema:Action ;
    rdfs:label "blockiert"@de, "blocks"@en ;
    rdfs:comment "Inverse zu ow:blockedBy; wird vom OWL-RL-Reasoner materialisiert, nicht doppelt gepflegt."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:subTaskOf a owl:ObjectProperty ;
    rdfs:subPropertyOf schema:isPartOf ;
    rdfs:domain schema:Action ;
    rdfs:range schema:Action ;
    rdfs:label "Teilaufgabe von"@de, "subtask of"@en ;
    rdfs:comment "Hierarchische Zerlegung von Aufgaben. schema:isPartOf ist auf CreativeWork ausgelegt; die Unterproperty hält die Aufgaben-Hierarchie von genereller Teil-Ganzes-Beziehung abfragbar getrennt."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:inProject a owl:ObjectProperty ;
    rdfs:subPropertyOf schema:isPartOf ;
    rdfs:range ow:Project ;
    rdfs:label "im Projekt"@de, "in project"@en ;
    rdfs:comment "Zuordnung einer Aufgabe (oder eines Dokuments) zu einem Projekt. schema.org drückt Projektzugehörigkeit von Actions nicht aus; schema:agent der Altfassung war semantisch falsch (das Projekt handelt nicht)."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# Quelltreue nativer Entitäten (Abschluss SPEC §12.4)
#
# Mit der Umstellung der Schreibpfade ist der Store die einzige
# Wahrheit — der native Zustand muss verlustfrei im Graphen liegen.
# Wo das Standard-Vokabular gröber ist als das native Modell, tragen
# diese Terme den exakten Zustand; die Standard-Projektion (z. B.
# schema:actionStatus) bleibt daneben für Interop erhalten — dasselbe
# Doppel-Muster wie beim Frontmatter des Obsidian-Connectors (M4).
#################################################################

ow:workflowStatus a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Workflow-Status"@de, "workflow status"@en ;
    rdfs:comment "Exakter nativer Workflow-Zustand einer Aufgabe ('backlog', 'todo', 'in-progress', 'review', 'done', 'on-hold') oder eines Projekts ('planning', 'active', 'completed', 'archived'). schema:actionStatus kennt nur drei ActionStatusType-Werte und gilt nicht für Projekte — ohne diesen Term wäre der Zustand nach dem Round-Trip verlustbehaftet."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:priority a owl:DatatypeProperty ;
    rdfs:domain schema:Action ;
    rdfs:range xsd:string ;
    rdfs:label "Priorität"@de, "priority"@en ;
    rdfs:comment "Priorität einer Aufgabe: 'low', 'medium', 'high' oder 'urgent'. Weder schema.org noch Dublin Core oder PROV kennen eine Aufgaben-Priorität."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:taskKind a owl:DatatypeProperty ;
    rdfs:domain schema:Action ;
    rdfs:range xsd:string ;
    rdfs:label "Aufgabenart"@de, "task kind"@en ;
    rdfs:comment "Native Art einer Aufgabe: 'task', 'bug', 'feature' oder 'milestone'. schema:additionalType erwartet frei interpretierbare URLs/Texte ohne kontrollierte Semantik; ein etabliertes Issue-Typen-Vokabular existiert nicht."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:deferredUntil a owl:DatatypeProperty ;
    rdfs:domain schema:Action ;
    rdfs:range xsd:dateTime ;
    rdfs:label "zurückgestellt bis"@de, "deferred until"@en ;
    rdfs:comment "Wiedervorlage-Zeitpunkt: Die Aufgabe ist bis dahin bewusst zurückgestellt. Bewusst nicht schema:scheduledTime — das wäre ein geplanter Ausführungszeitpunkt, keine Zurückstellung; schema:startTime trägt bereits den geplanten Beginn."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:estimatedEffort a owl:DatatypeProperty ;
    rdfs:domain schema:Action ;
    rdfs:range xsd:decimal ;
    rdfs:label "geschätzter Aufwand"@de, "estimated effort"@en ;
    rdfs:comment "Geschätzter Aufwand in Stunden. schema:timeRequired gilt für CreativeWork/HowTo und ist eine ISO-Duration für Lernaufwand, kein Planwert für Actions."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:actualEffort a owl:DatatypeProperty ;
    rdfs:domain schema:Action ;
    rdfs:range xsd:decimal ;
    rdfs:label "tatsächlicher Aufwand"@de, "actual effort"@en ;
    rdfs:comment "Tatsächlich aufgewendete Stunden (Ist-Wert zu ow:estimatedEffort). Kein Standard-Vokabular modelliert Ist-Aufwand auf Aktionsebene."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:dependencyKind a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Abhängigkeitsart"@de, "dependency kind"@en ;
    rdfs:comment "Kanten-Annotation (RDF 1.2, am Reifier eines ow:blockedBy-Tripels): Projektmanagement-Typ der Abhängigkeit — 'FS' (Finish-to-Start, Default, wird nicht materialisiert), 'SS', 'FF' oder 'SF'. Kein Standard-Vokabular typisiert Vorgänger-Beziehungen; eine eigene Kantenklasse wäre Reifikations-Boilerplate (SPEC §3.1)."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# Skills, Agenten, Werkzeuge
#
# Die Prädikate spiegeln bewusst die Feldnamen der A2A-AgentCard
# (endpoints, securitySchemes, skills), damit eine spätere Brücke
# zu A2A eine Umbenennung ist und kein Remodelling (SPEC §4.3).
#################################################################

ow:trigger a owl:DatatypeProperty ;
    rdfs:domain ow:Skill ;
    rdfs:range xsd:string ;
    rdfs:label "Auslöser"@de, "trigger"@en ;
    rdfs:comment "Beschreibung, wann ein Skill anzuwenden ist (SKILL.md-Frontmatter 'description'/'trigger'). Kein Standard-Term modelliert Aktivierungsbedingungen prozeduralen Wissens."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:skillSource a owl:DatatypeProperty ;
    rdfs:domain ow:Skill ;
    rdfs:range xsd:string ;
    rdfs:label "Skill-Quelle"@de, "skill source"@en ;
    rdfs:comment "Ladeweg des Skills (manuell, URL, GitHub-Repo, MCP-Prompt) samt Locator. Herkunftsangabe unterhalb der PROV-Granularität; prov:wasDerivedFrom referenziert Entitäten, hier ist es ein Konfigurationswert."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:providesSkill a owl:ObjectProperty ;
    rdfs:range ow:Skill ;
    rdfs:label "bietet Skill an"@de, "provides skill"@en ;
    rdfs:comment "Ein Agent bietet einen Skill an (A2A-AgentCard 'skills'). schema:knowsAbout ist zu unspezifisch: es behauptet Themenwissen, nicht abrufbare Fähigkeit."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:agentCardUrl a owl:DatatypeProperty ;
    rdfs:domain ow:Agent ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Agent-Card-URL"@de, "agent card URL"@en ;
    rdfs:comment "URL der A2A-AgentCard (/.well-known/agent-card.json). Bewusst getrennt von schema:url (der Homepage des Agenten): die Card ist ein maschinenlesbares Capability-Dokument."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:endpoint a owl:DatatypeProperty ;
    rdfs:range xsd:anyURI ;
    rdfs:label "Endpoint"@de, "endpoint"@en ;
    rdfs:comment "Aufruf-Endpoint eines Agenten oder MCP-Servers (A2A-AgentCard 'endpoints'). schema:url bezeichnet die Referenz-URL eines Dings, nicht die maschinelle Aufruffläche."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:securityScheme a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Security-Scheme"@de, "security scheme"@en ;
    rdfs:comment "Authentifizierungsschema als Literal (A2A-AgentCard 'securitySchemes', JSON). Kein etabliertes RDF-Vokabular für API-Auth-Schemata; das Literal hält die A2A-Struktur verlustfrei."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:transport a owl:DatatypeProperty ;
    rdfs:domain ow:ToolProvider ;
    rdfs:range xsd:string ;
    rdfs:label "Transport"@de, "transport"@en ;
    rdfs:comment "MCP-Transportart des Servers ('streamable-http', 'sse', 'stdio'). Protokollspezifisch, kein Standard-Äquivalent."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:inputSchema a owl:DatatypeProperty ;
    rdfs:domain ow:Tool ;
    rdfs:range xsd:string ;
    rdfs:label "Eingabe-Schema"@de, "input schema"@en ;
    rdfs:comment "JSON-Schema der Tool-Parameter als Literal. Eine Abbildung von JSON-Schema nach RDF wäre verlustbehaftet und für den Zweck (Weitergabe an LLM-Function-Calling) kontraproduktiv."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:providedBy a owl:ObjectProperty ;
    rdfs:subPropertyOf schema:provider ;
    rdfs:domain ow:Tool ;
    rdfs:range ow:ToolProvider ;
    rdfs:label "bereitgestellt von"@de, "provided by"@en ;
    rdfs:comment "Verbindet ein Werkzeug mit seinem MCP-Server. Unterproperty von schema:provider, damit generische Clients die Beziehung auf der Oberkategorie auswerten können."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:requiresTool a owl:ObjectProperty ;
    rdfs:subPropertyOf schema:tool ;
    rdfs:domain ow:Skill ;
    rdfs:range ow:Tool ;
    rdfs:label "benötigt Werkzeug"@de, "requires tool"@en ;
    rdfs:comment "Ein Skill benötigt ein aufrufbares Werkzeug (ergänzt mit M9). schema:tool bezeichnet generische Hilfsmittel einer Anleitung (HowToTool oder Text) ohne Verfügbarkeits-Anspruch; die Spezialisierung macht den maschinellen Werkzeugbedarf (LLM-Function-Calling) als harte Voraussetzung abfragbar — welche Skills welche Tools brauchen, ist die M9-Abnahmefrage. Als Unterproperty bleibt die Beziehung für generische Clients auf schema:tool auswertbar."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# Connectors und Föderation
#################################################################

ow:connectorKind a owl:DatatypeProperty ;
    rdfs:domain ow:Connector ;
    rdfs:range xsd:string ;
    rdfs:label "Connector-Art"@de, "connector kind"@en ;
    rdfs:comment "Registrierte Art des Connectors (z. B. 'github-rdf', 'obsidian-vault', 'sparql-endpoint'). Interner Registry-Schlüssel ohne Standard-Äquivalent."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:locator a owl:DatatypeProperty ;
    rdfs:domain ow:Connector ;
    rdfs:range xsd:string ;
    rdfs:label "Quell-Locator"@de, "source locator"@en ;
    rdfs:comment "Adresse der Quelle (Repo-URL, Vault-Pfad, Endpoint-URL, Agent-Card-URL). Bewusst breiter als xsd:anyURI, weil lokale Pfade und opaque Bezeichner vorkommen."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:revision a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Revision"@de, "revision"@en ;
    rdfs:comment "Quell-Revision eines Imports (Commit-SHA, ETag, mtime-Hash). Grundlage der Konflikterkennung vor push; kein Standard-Term trägt versionsübergreifende opake Revisionsbezeichner."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:syncState a owl:DatatypeProperty ;
    rdfs:domain ow:Connector ;
    rdfs:range xsd:string ;
    rdfs:label "Sync-Zustand"@de, "sync state"@en ;
    rdfs:comment "Betriebszustand der Connector-Instanz ('idle', 'syncing', 'error', 'conflict'). Systemzustand, kein Wissensinhalt; als eigener Term, damit das Selbstmodell abfragbar bleibt."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:targetGraph a owl:ObjectProperty ;
    rdfs:domain ow:Connector ;
    rdfs:label "Ziel-Graph"@de, "target graph"@en ;
    rdfs:comment "Named Graph, in den ein materialisierender Connector schreibt (graph/<u>/import/<id>). Verweist auf die Graph-IRI selbst; kein Standard-Term modelliert Schreibziele von Import-Prozessen."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:sparqlEndpoint a owl:DatatypeProperty ;
    owl:equivalentProperty void:sparqlEndpoint ;
    rdfs:domain ow:FederatedEndpoint ;
    rdfs:range xsd:anyURI ;
    rdfs:label "SPARQL-Endpoint"@de, "SPARQL endpoint"@en ;
    rdfs:comment "Query-URL des föderierten Endpoints. Äquivalent zu void:sparqlEndpoint; eigener Term nur, damit das Kernvokabular ohne VoID-Import vollständig bleibt (as: und void: werden erst bei Bedarf geladen, SPEC §4.1)."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:trustLevel a owl:DatatypeProperty ;
    rdfs:domain ow:FederatedEndpoint ;
    rdfs:range xsd:string ;
    rdfs:label "Vertrauensstufe"@de, "trust level"@en ;
    rdfs:comment "Vertrauensstufe eines föderierten Endpoints ('trusted', 'known', 'unknown'); steuert, ob ausgehende SERVICE-Aufrufe Bindings aus privaten Graphen senden dürfen. Sicherheitsattribut ohne Standard-Äquivalent."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# Kalender und Chats (M15)
#
# Termine sind schema:Event, ihre Quelle ein schema:DataFeed, Chats
# sind schema:Conversation mit schema:Message — die Standardklassen
# tragen alles außer den drei Tatsachen hier, für die es keine gibt.
#################################################################

ow:enabled a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "aktiv"@de, "enabled"@en ;
    rdfs:comment "Ist eine konfigurierte Quelle eingeschaltet (abonnierter Kalender)? Abgegrenzt von ow:syncState, der den Betriebszustand eines Connector-Laufs beschreibt: hier geht es um die Absicht des Nutzers, nicht um das Ergebnis eines Laufs. schema:isAccessibleForFree und Verwandte betreffen Zugänglichkeit von Inhalten, nicht das Ein-/Ausschalten einer Quelle."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:allDay a owl:DatatypeProperty ;
    rdfs:domain schema:Event ;
    rdfs:range xsd:boolean ;
    rdfs:label "ganztägig"@de, "all day"@en ;
    rdfs:comment "Ganztägiger Termin (iCalendar DTSTART;VALUE=DATE). schema:Event kennt die Unterscheidung nicht; sie über den Datentyp der Zeitangabe (xsd:date statt xsd:dateTime) auszudrücken, verlöre die aus der Quelle übernommene Uhrzeit des Zeitraums und damit die Quelltreue."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:messageRole a owl:DatatypeProperty ;
    rdfs:domain schema:Message ;
    rdfs:range xsd:string ;
    rdfs:label "Nachrichten-Rolle"@de, "message role"@en ;
    rdfs:comment "Rolle der Nachricht im Dialog ('user' oder 'assistant'), die Rollen-Achse der Chat-Protokolle. schema:sender/schema:recipient verlangen einen benannten Agenten als Objekt — den gibt es hier nicht, ohne eine Person oder Anwendung zu erfinden, die der Nutzer nie angelegt hat (Invariante 10)."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# AI-Konfiguration (M15)
#
# Der Spiegel in graph/meta wird generiert (§18-Muster wie M9):
# Geheimnisse werden nie abgebildet, und gespiegelt wird nur, was
# konfiguriert IST — nie ein erfundenes Live-Modellinventar.
#################################################################

ow:providerKind a owl:DatatypeProperty ;
    rdfs:domain ow:InferenceProvider ;
    rdfs:range xsd:string ;
    rdfs:label "Provider-Art"@de, "provider kind"@en ;
    rdfs:comment "Katalog-Kennung der Inferenz-Quelle ('ollama', 'openai', 'webllm', …), die Protokoll und Voreinstellungen bestimmt. Bewusst nicht ow:connectorKind: dessen rdfs:domain ist ow:Connector, und ein bestehender Term wird nach SPEC §4.4 nie umdefiniert — über OWL RL wäre sonst jeder Provider ein Connector."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:toolCallMode a owl:DatatypeProperty ;
    rdfs:domain ow:InferenceProvider ;
    rdfs:range xsd:string ;
    rdfs:label "Tool-Aufruf-Verfahren"@de, "tool call mode"@en ;
    rdfs:comment "Wie Werkzeugaufrufe gegen diesen Provider laufen: 'native' (Protokoll-Feld), 'text' (universelle Text-Syntax) oder 'auto'. Die Antwort auf 'welche meiner Quellen kann Werkzeuge aufrufen' — kein Standard-Vokabular beschreibt Aufruf-Verfahren von Sprachmodell-Endpunkten."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:defaultModel a owl:ObjectProperty ;
    rdfs:domain ow:InferenceProvider ;
    rdfs:range ow:Model ;
    rdfs:label "Standard-Modell"@de, "default model"@en ;
    rdfs:comment "Modell, das dieser Provider ohne ausdrückliche Wahl benutzt. schema:model verbindet ein Produkt mit seiner Modellreihe (ProductModel) und trägt keine Voreinstellungs-Semantik; ohne eigenen Term wäre die Voreinstellung von den übrigen konfigurierten Modellen nicht unterscheidbar."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# Präsentationsbezug
#################################################################

ow:rendersNode a owl:ObjectProperty ;
    rdfs:domain ow:CanvasNode ;
    rdfs:label "stellt Knoten dar"@de, "renders node"@en ;
    rdfs:comment "Verbindet ein Layout-Element in graph/presentation mit dem semantischen Knoten, den es darstellt. Die einzige Brücke zwischen Präsentations- und Wissensschicht; Layout-Werte selbst (Position, Farbe) stehen nie im semantischen Graphen."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# Canvas-Layout (graph/presentation, SPEC §9 / M5)
#
# Diese Terme beschreiben ausschließlich DARSTELLUNG und stehen nur
# in graph/<u>/presentation — nie im semantischen Graphen (der
# Blacklist-Test in tests/graph/migrate.test.ts erzwingt das).
# Breite/Höhe/Farbe nutzen schema:width/schema:height/schema:color
# (Invariante 8: fremdes Vokabular vor eigenem); für 2D-Position,
# Viewport und die JSON-Canvas-1.0-Attribute existiert kein
# etabliertes RDF-Vokabular, daher eigene Terme.
#################################################################

ow:CanvasNode a owl:Class ;
    rdfs:label "Canvas-Knoten"@de, "canvas node"@en ;
    rdfs:comment "Platziertes Layout-Element auf einem Canvas (JSON Canvas 1.0 'node'): Position, Größe, Farbe, Darstellungsart. Referenziert den dargestellten Wissensknoten über ow:rendersNode und sein Canvas über schema:isPartOf. Kein Standard-Vokabular modelliert 2D-Canvas-Layout; schema:width/height/color werden als Werte-Properties wiederverwendet."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:CanvasEdge a owl:Class ;
    rdfs:label "Canvas-Kante"@de, "canvas edge"@en ;
    rdfs:comment "Gezeichnete Verbindungslinie zwischen zwei Canvas-Knoten (JSON Canvas 1.0 'edge'): Anker-Seiten, Pfeilenden, Farbe, Beschriftung. Reine Darstellung — die Wissens-Behauptung der Verbindung ist ein ow:linksTo-Tripel im semantischen Graphen (SPEC §9)."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:nodeKind a owl:DatatypeProperty ;
    rdfs:domain ow:CanvasNode ;
    rdfs:range xsd:string ;
    rdfs:label "Darstellungsart"@de, "node kind"@en ;
    rdfs:comment "Darstellungsart des Canvas-Knotens nach JSON Canvas 1.0: 'text', 'file', 'link' oder 'group'. Explizit gespeichert statt aus dem semantischen Gegenstück inferiert, damit der Export deterministisch bleibt. Kein Standard-Äquivalent."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:cardKind a owl:DatatypeProperty ;
    rdfs:domain ow:CanvasNode ;
    rdfs:range xsd:string ;
    rdfs:label "Kartentyp"@de, "card kind"@en ;
    rdfs:comment "Nativer Kartentyp einer Workspace-Pinnwand, wo er feiner ist als ow:nodeKind: 'task' (nodeKind 'text') und 'image' (nodeKind 'file'). Nur bei Abweichung vom nodeKind-Default materialisiert — Quelltreue-Träger für den Round-Trip nativer Pinnwände (Abschluss SPEC §12.4), kein Standard-Äquivalent."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:xPosition a owl:DatatypeProperty ;
    rdfs:domain ow:CanvasNode ;
    rdfs:range xsd:decimal ;
    rdfs:label "X-Position"@de, "x position"@en ;
    rdfs:comment "Horizontale Position des Layout-Elements in Canvas-Koordinaten (JSON Canvas 1.0 'x'). schema:position ist eine Ordnungszahl in Serien, keine 2D-Koordinate; ein etabliertes Layout-Vokabular existiert nicht."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:yPosition a owl:DatatypeProperty ;
    rdfs:domain ow:CanvasNode ;
    rdfs:range xsd:decimal ;
    rdfs:label "Y-Position"@de, "y position"@en ;
    rdfs:comment "Vertikale Position des Layout-Elements in Canvas-Koordinaten (JSON Canvas 1.0 'y'). Begründung wie ow:xPosition."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:filePath a owl:DatatypeProperty ;
    rdfs:domain ow:CanvasNode ;
    rdfs:range xsd:string ;
    rdfs:label "Dateipfad"@de, "file path"@en ;
    rdfs:comment "Vault-relativer Pfad eines file-Knotens (JSON Canvas 1.0 'file', optional mit angehängtem '#subpath' — Obsidian verbietet '#' in Dateinamen, die Trennung ist eindeutig). Quelltreue-Träger für den Round-Trip; die Wissens-Referenz auf das Dokument läuft über ow:rendersNode."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:background a owl:DatatypeProperty ;
    rdfs:domain ow:CanvasNode ;
    rdfs:range xsd:string ;
    rdfs:label "Hintergrundbild"@de, "background image"@en ;
    rdfs:comment "Pfad des Hintergrundbilds einer Gruppe (JSON Canvas 1.0 'background'). Reines Darstellungsattribut; schema:image würde eine Bild-Aussage über ein Wissens-Ding treffen."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:backgroundStyle a owl:DatatypeProperty ;
    rdfs:domain ow:CanvasNode ;
    rdfs:range xsd:string ;
    rdfs:label "Hintergrund-Stil"@de, "background style"@en ;
    rdfs:comment "Darstellung des Gruppen-Hintergrundbilds nach JSON Canvas 1.0: 'cover', 'ratio' oder 'repeat'. Kein Standard-Äquivalent."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:viewportX a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "Ansichts-X"@de, "viewport x"@en ;
    rdfs:comment "Horizontale Verschiebung des gespeicherten Ansichtsfensters eines Canvas (am ow:Canvas-Subjekt, nur in graph/presentation). JSON Canvas 1.0 kennt kein Viewport — natives Workspace-Layout braucht es; kein Standard-Äquivalent."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:viewportY a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "Ansichts-Y"@de, "viewport y"@en ;
    rdfs:comment "Vertikale Verschiebung des gespeicherten Ansichtsfensters eines Canvas. Begründung wie ow:viewportX."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:viewportZoom a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "Ansichts-Zoom"@de, "viewport zoom"@en ;
    rdfs:comment "Zoomfaktor des gespeicherten Ansichtsfensters eines Canvas. Begründung wie ow:viewportX."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:edgeFrom a owl:ObjectProperty ;
    rdfs:domain ow:CanvasEdge ;
    rdfs:range ow:CanvasNode ;
    rdfs:label "Kante von"@de, "edge from"@en ;
    rdfs:comment "Start-Layout-Knoten einer gezeichneten Canvas-Kante (JSON Canvas 1.0 'fromNode'). Verbindet Layout-Elemente, nicht Wissensknoten — auch Gruppen ohne semantisches Gegenstück sind gültige Endpunkte."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:edgeTo a owl:ObjectProperty ;
    rdfs:domain ow:CanvasEdge ;
    rdfs:range ow:CanvasNode ;
    rdfs:label "Kante nach"@de, "edge to"@en ;
    rdfs:comment "Ziel-Layout-Knoten einer gezeichneten Canvas-Kante (JSON Canvas 1.0 'toNode'). Begründung wie ow:edgeFrom."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:fromSide a owl:DatatypeProperty ;
    rdfs:domain ow:CanvasEdge ;
    rdfs:range xsd:string ;
    rdfs:label "Start-Seite"@de, "from side"@en ;
    rdfs:comment "Anker-Seite der Kante am Start-Knoten nach JSON Canvas 1.0: 'top', 'right', 'bottom' oder 'left'. Nur gespeichert, wenn die Quelle sie explizit setzt (Round-Trip-Treue). Kein Standard-Äquivalent."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:toSide a owl:DatatypeProperty ;
    rdfs:domain ow:CanvasEdge ;
    rdfs:range xsd:string ;
    rdfs:label "Ziel-Seite"@de, "to side"@en ;
    rdfs:comment "Anker-Seite der Kante am Ziel-Knoten. Begründung wie ow:fromSide."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:fromEnd a owl:DatatypeProperty ;
    rdfs:domain ow:CanvasEdge ;
    rdfs:range xsd:string ;
    rdfs:label "Start-Ende"@de, "from end"@en ;
    rdfs:comment "Linienende am Start der Kante nach JSON Canvas 1.0: 'none' oder 'arrow' (Default 'none'). Nur gespeichert, wenn die Quelle es explizit setzt. Kein Standard-Äquivalent."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:toEnd a owl:DatatypeProperty ;
    rdfs:domain ow:CanvasEdge ;
    rdfs:range xsd:string ;
    rdfs:label "Ziel-Ende"@de, "to end"@en ;
    rdfs:comment "Linienende am Ziel der Kante nach JSON Canvas 1.0: 'none' oder 'arrow' (Default 'arrow'). Nur gespeichert, wenn die Quelle es explizit setzt. Kein Standard-Äquivalent."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# Chat-Darstellung (graph/presentation, M15)
#
# Wie die Canvas-Layout-Terme stehen diese ausschließlich in
# graph/<u>/presentation: die generative Oberfläche einer Antwort
# und die zuletzt geöffnete Unterhaltung sind Darstellung, nicht
# Wissen (Invariante 2).
#################################################################

ow:generativeSurface a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "generative Oberfläche"@de, "generative surface"@en ;
    rdfs:comment "Die zu einer Antwort erzeugte A2UI-Oberfläche als JSON-Literal (Muster wie ow:inputSchema/ow:retrievalConfig). Sie gehört zur Nachricht, ist aber Darstellung: Der Wissensinhalt der Nachricht steht in schema:text. Eine tripelweise Abbildung der Komponentenbäume würde Präsentationsstruktur in den Graphen ziehen, die kein Client außer dieser Oberfläche interpretieren kann."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:selected a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "ausgewählt"@de, "selected"@en ;
    rdfs:comment "Markiert die zuletzt geöffnete Unterhaltung, damit die Oberfläche sie nach einem Neustart wieder anzeigt. Reine Auswahl der Ansicht ohne Aussage über den Inhalt — deshalb im Präsentationsgraphen und kein Standard-Term (schema.org modelliert keine UI-Auswahl)."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# Generierte Query-Views (SPEC §9 / M5)
#################################################################

ow:QueryView a owl:Class ;
    rdfs:subClassOf schema:CreativeWork ;
    rdfs:label "Query-View"@de, "query view"@en ;
    rdfs:comment "Generierte Graph-Ansicht aus einer gespeicherten SPARQL-Query (Live-Subgraph): hat kein persistiertes Layout, sondern ein Layout-Verfahren (SPEC §9). Abgegrenzt von ow:Canvas, dessen Anordnung manuell kuratiert und persistiert ist. Kein Standard-Vokabular modelliert gespeicherte Graph-Views."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:queryText a owl:DatatypeProperty ;
    rdfs:domain ow:QueryView ;
    rdfs:range xsd:string ;
    rdfs:label "Query-Text"@de, "query text"@en ;
    rdfs:comment "SPARQL-Text der gespeicherten Query. CONSTRUCT/DESCRIBE ergeben eine auflösbare Graph-View; SELECT/ASK sind gespeicherte Editor-Queries (SPEC §7.1) — dieselbe Entität, unterschieden am Query-Text. sh:select trägt SHACL-Constraint-Semantik, spin:text ist kein gepflegter Standard, schema:text ist Anzeige-Inhalt von Werken — daher eigener Term."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:layoutMethod a owl:DatatypeProperty ;
    rdfs:domain ow:QueryView ;
    rdfs:range xsd:string ;
    rdfs:label "Layout-Verfahren"@de, "layout method"@en ;
    rdfs:comment "Layout-Verfahren einer generierten View: 'force-directed', 'hierarchical' oder 'radial' (SPEC §9). Ein Verfahren statt persistierter Koordinaten — deshalb kein Fall für die Canvas-Layout-Terme; kein Standard-Äquivalent."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# Suche und Multi-Hop-Retrieval (SPEC §7.5/§7.7 / M8)
#################################################################

ow:RetrievalProfile a owl:Class ;
    rdfs:subClassOf schema:CreativeWork ;
    rdfs:label "Retrieval-Profil"@de, "retrieval profile"@en ;
    rdfs:comment "Gespeicherter Parametersatz der Multi-Hop-Retrieval-Pipeline (SPEC §7.5): Seeds-Strategie, Hop-Tiefe, Filter, Decay, Kappungen. Als Graph-Entität selbst abfragbar — ein Profil ist Konfigurations-Wissen, keine externe Datei. Kein Standard-Vokabular modelliert Retrieval-Parameter."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:retrievalConfig a owl:DatatypeProperty ;
    rdfs:domain ow:RetrievalProfile ;
    rdfs:range xsd:string ;
    rdfs:label "Retrieval-Konfiguration"@de, "retrieval configuration"@en ;
    rdfs:comment "Die RetrievalRequest-Parameter des Profils als JSON-Literal (Muster wie ow:inputSchema): eine tripelweise RDF-Abbildung jedes Einzelparameters wäre verlustbehaftet gegenüber der verbindlichen TypeScript-Schnittstelle aus SPEC §7.5 und für den Zweck (Wiederausführung) kontraproduktiv."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:weight a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "Kantengewicht"@de, "edge weight"@en ;
    rdfs:comment "Relevanz-Gewicht einer einzelnen Kante als RDF-1.2-Annotation am benannten Reifier (rdf:reifies + Triple Term), ausgewertet vom Retrieval-Scoring (SPEC §7.5: 'Kantengewicht aus RDF-star-Annotation, falls vorhanden'). Werte in (0,10], Default ohne Annotation ist 1. Kein Standard-Term modelliert Statement-Gewichte; schema:weight existiert nicht, Fuzzy-/Ranking-Vokabulare sind nicht etabliert."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# Multi-User: geteilte Räume (SPEC §17.1 / M13)
#################################################################

ow:Space a owl:Class ;
    rdfs:subClassOf schema:CreativeWork ;
    rdfs:label "Geteilter Raum"@de, "shared space"@en ;
    rdfs:comment "Gemeinsam genutzter Named Graph mit eigener Mitgliederliste (SPEC §17.1): eine Entität mit Eigentümer (acl:owner), Beschreibung und einem Graphen (ow:targetGraph), in dem die Mitglieder gemeinsam arbeiten. Abgegrenzt von foaf:Group — eine Gruppe ist eine Menge von Agenten, ein Raum ein Ort mit Inhalt; die Rollen der Mitglieder sind ACL-Regeln auf dem Graphen des Raums und werden nicht zweitverwaltet. schema:Organization beschreibt eine Institution, nicht einen Arbeitsbereich; kein Standard-Vokabular modelliert einen geteilten Named Graph."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:spaceGraph a owl:ObjectProperty ;
    rdfs:domain ow:Space ;
    rdfs:label "Raum-Graph"@de, "space graph"@en ;
    rdfs:comment "Named Graph, in dem der Inhalt eines geteilten Raums liegt (graph/shared/<id>). Bewusst nicht ow:targetGraph: dessen rdfs:domain ist ow:Connector, und ein bestehender Term wird nach SPEC §4.4 nie umdefiniert — eine Domain-Erweiterung würde über OWL RL jeden Raum zum Connector machen. Kein Standard-Term benennt den Graphen einer Entität; sd:name aus der SPARQL-Service-Description beschreibt Graphen eines Dienstes, nicht die Zugehörigkeit zu einer Anwendungsentität."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# Selbstmodell und Einführungsstrecke (SPEC §18 / M14)
#################################################################

ow:Module a owl:Class ;
    rdfs:subClassOf schema:WebPage ;
    rdfs:label "Modul"@de, "module"@en ;
    rdfs:comment "Funktionsbereich der Anwendung im Selbstmodell (SPEC §18): eine Seite mit Route, Beschreibung und den Entitätstypen, die sie verwaltet. schema:WebPage trägt die Seiten-Semantik, unterscheidet aber nicht zwischen der Selbstbeschreibung dieser Installation und Webseiten importierter Quellen — die Frage 'welche Module hat dieses System' braucht genau diese Trennung. Wird beim Start aus der Modul-Registry im Code erzeugt, nie von Hand gepflegt."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:route a owl:DatatypeProperty ;
    rdfs:domain ow:Module ;
    rdfs:range xsd:string ;
    rdfs:label "Route"@de, "route"@en ;
    rdfs:comment "Anwendungspfad eines Moduls ('/tasks'). Bewusst nicht schema:url: Die URL einer Installation hängt vom Base-Path ab (Home-Assistant-Ingress steht erst zur Installationszeit fest, SPEC §5.2/M12) und wäre damit deployment-spezifisch; die Route ist die installationsunabhängige Identität der Seite und das, worauf der Assistent den aktuellen Standort des Nutzers abbildet."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:entityType a owl:ObjectProperty ;
    rdfs:domain ow:Module ;
    rdfs:label "Entitätstyp"@de, "entity type"@en ;
    rdfs:comment "Klasse, deren Entitäten ein Modul verwaltet (ow:Task für /tasks). Damit ist 'wo bearbeite ich diesen Knotentyp' abfragbar, statt im Prompt-Text zu stehen. void:class beschreibt die Partition eines Datensatzes und hat void:Dataset als Domain, nicht die Zuständigkeit eines Anwendungsteils; schema:about wäre unspezifisch, weil es Themen und nicht Typen benennt."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:capability a owl:DatatypeProperty ;
    rdfs:domain schema:SoftwareApplication ;
    rdfs:range xsd:string ;
    rdfs:label "Fähigkeit"@de, "capability"@en ;
    rdfs:comment "Aktive Fähigkeit der laufenden Runtime, ein Schlüssel aus fester Menge (sparqlEndpoint, mcpServer, federationOutbound, federationInbound, multiUser) bzw. Schlüssel:Wert für abgestufte Fähigkeiten (reasoning:rl). Nur was die Runtime wirklich kann, wird behauptet (Invariante 10) — deshalb kein boolesches Feld pro Fähigkeit, dessen 'false' erst gelesen werden müsste. schema:featureList ist eine Freitext-Aufzählung für die Beschreibung von Software, kein Schlüsselraum, gegen den sich Abfragen formulieren lassen."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:runtime a owl:DatatypeProperty ;
    rdfs:domain schema:SoftwareApplication ;
    rdfs:range xsd:string ;
    rdfs:label "Laufzeitumgebung"@de, "runtime"@en ;
    rdfs:comment "Kennung der laufenden Runtime (local | ha-addon | server, SPEC §5.2). Sie entscheidet, welche Fähigkeiten überhaupt möglich sind, und gehört deshalb in die Selbstbeschreibung. schema:operatingSystem und schema:runtimePlatform benennen die technische Plattform (Node, Browser), nicht die Betriebsart dieser Anwendung."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:availableConnectorKind a owl:DatatypeProperty ;
    rdfs:domain schema:SoftwareApplication ;
    rdfs:range xsd:string ;
    rdfs:label "Verfügbare Connector-Art"@de, "available connector kind"@en ;
    rdfs:comment "Connector-Art, die dieser Build anbietet (Katalog aus connectors/catalog.ts) — die Antwort auf 'welche Quellen kann dieses System einbinden', im Unterschied zu 'welche sind eingebunden' (das sagen die ow:Connector-Instanzen). Bewusst nicht ow:connectorKind: dessen rdfs:domain ist ow:Connector, und ein bestehender Term wird nach SPEC §4.4 nie umdefiniert — über OWL RL wäre die Anwendung sonst selbst ein Connector."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:OnboardingStep a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Einführungsschritt"@de, "onboarding step"@en ;
    rdfs:comment "Ausgeführter Schritt der Einführungsstrecke (SPEC §18) als reale Aktivität im Graphen: wer ihn wann ausgeführt hat (prov:wasAttributedTo, prov:endedAtTime) und was dabei entstanden ist (prov:generated). Der Fortschritt ist damit abfragbar statt UI-Zustand, und 'rückgängig' heißt: den Schritt und das von ihm Erzeugte löschen. prov:Activity trägt die Semantik, benennt aber nicht die Rolle im Ablauf — ohne Markierung wäre ein Einführungsschritt von jedem Sync-Lauf und jeder Freigabe ununterscheidbar."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# Beobachtungsgrößen und ihre Erfassung
#
# Kausal-Layer (CAUSAL_LAYER_SPEC §5/§6): Der Graph trägt, WAS erfasst
# wird und WIE — die Messwerte selbst liegen daneben im Beobachtungs-
# Speicher und nie als Tripel (Invariante C3). Die Struktur der Quellen
# (Gerät, Sensor, beobachtete Größe, Ort) kommt aus SOSA und schema.org;
# eigene Terme entstehen nur für die Erfassungsregel, die dort fehlt.
#################################################################

ow:Variable a owl:Class ;
    rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty> ;
    rdfs:label "Beobachtungsgröße"@de, "variable"@en ;
    rdfs:comment "Eine Größe, deren Zeitreihe dieser Workspace dauerhaft erfasst, samt Erfassungsregel: Quelle, Verdichtung, Abtastabstand, Aufbewahrung, Wasserzeichen. sosa:ObservableProperty benennt die beobachtbare Eigenschaft, sagt aber nichts über Erfassung und Aufbewahrung — genau das unterscheidet eine erfasste Variable von einer bloß beobachtbaren Eigenschaft, und genau das muss abfragbar sein, damit eine kausale Studie reproduzierbar ist. Die Messwerte stehen NIE im Graphen: eine Reihe mit Millionen Punkten wäre als Tripel unbrauchbar und würde nie per SPARQL gelesen."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:observationSource a owl:DatatypeProperty ;
    rdfs:domain ow:Variable ;
    rdfs:range xsd:string ;
    rdfs:label "Quellschlüssel"@de, "observation source"@en ;
    rdfs:comment "Schlüssel der Größe in ihrer Quelle, quelltreu (bei Home Assistant die entity_id, z. B. 'sensor.wohnzimmer_temperatur'). Er ist die Adresse, unter der die Erfassung nachlädt, und überlebt Umbenennungen der Anzeige. dcterms:identifier trägt bereits die workspace-eigene stabile ID der Variablen; beides in einen Term zu legen, machte unauflösbar, welcher Bezeichner in welchem System gilt."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:observationKind a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Messgrößenart"@de, "observation kind"@en ;
    rdfs:comment "Skalenniveau der Reihe: 'numeric', 'binary' oder 'categorical'. Es entscheidet, welche Verdichtung zulässig ist (ein Mittelwert über Lichtschalter-Zustände ist sinnlos) und welcher Schätzer später überhaupt in Frage kommt. Kein Standard-Vokabular führt das Skalenniveau als abfragbares Attribut einer Messreihe; schema:measurementTechnique beschreibt das Verfahren, nicht die Werteart."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:aggregation a owl:DatatypeProperty ;
    rdfs:domain ow:Variable ;
    rdfs:range xsd:string ;
    rdfs:label "Verdichtung"@de, "aggregation"@en ;
    rdfs:comment "Regel, mit der Rohwerte auf das Abtastraster verdichtet werden ('last', 'mean', 'min', 'max', 'sum'). Sie ist Teil der Definition der Variablen, nicht der Auswertung: dieselbe Quelle mit 'mean' und mit 'last' sind zwei verschiedene Größen. Ohne festgehaltene Verdichtung ist keine Studie reproduzierbar (Invariante C7)."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:samplingInterval a owl:DatatypeProperty ;
    rdfs:domain ow:Variable ;
    rdfs:range xsd:duration ;
    rdfs:label "Abtastabstand"@de, "sampling interval"@en ;
    rdfs:comment "Zeitraster der erfassten Reihe als xsd:duration (z. B. PT5M). Es begrenzt das Datenvolumen und macht mehrere Reihen ohne Nachbearbeitung gemeinsam auswertbar. schema:frequency ist Freitext für Publikationsrhythmen und nicht als Dauer typisiert."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:captureEnabled a owl:DatatypeProperty ;
    rdfs:domain ow:Variable ;
    rdfs:range xsd:boolean ;
    rdfs:label "Erfassung aktiv"@de, "capture enabled"@en ;
    rdfs:comment "Absicht des Nutzers: Soll diese Größe weiter erfasst werden? Abgegrenzt von ow:captureState (Ergebnis des letzten Laufs) und von ow:enabled, dessen rdfs:domain die abonnierte Quelle ist — ein bestehender Term wird nach SPEC §4.4 nie umdefiniert. Ausgeschaltet heißt: nicht mehr nachladen, Bestand behalten."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:captureState a owl:DatatypeProperty ;
    rdfs:domain ow:Variable ;
    rdfs:range xsd:string ;
    rdfs:label "Erfassungszustand"@de, "capture state"@en ;
    rdfs:comment "Betriebszustand der Erfassung einer Größe ('idle', 'capturing', 'error'). Systemzustand, kein Wissensinhalt — dieselbe Rolle wie ow:syncState beim Connector, aber ein eigener Term, weil dessen rdfs:domain ow:Connector ist und eine Variable über OWL RL sonst zum Connector würde."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:capturedFrom a owl:DatatypeProperty ;
    rdfs:domain ow:Variable ;
    rdfs:range xsd:dateTime ;
    rdfs:label "Erfasst ab"@de, "captured from"@en ;
    rdfs:comment "Ältester Zeitpunkt, für den der Beobachtungs-Speicher dieser Größe Werte hält. Er sagt, wie weit eine Auswertung überhaupt zurückreichen kann, und ist damit die ehrliche Grenze jeder Studie. schema:startDate benennt den Beginn eines Ereignisses, nicht die Abdeckung eines Bestands."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:capturedThrough a owl:DatatypeProperty ;
    rdfs:domain ow:Variable ;
    rdfs:range xsd:dateTime ;
    rdfs:label "Erfasst bis"@de, "captured through"@en ;
    rdfs:comment "Wasserzeichen der Erfassung: jüngster übernommener Zeitpunkt. Der nächste Lauf holt ausschließlich Werte danach — dadurch ist jeder Lauf idempotent und ein Wiederholen erzeugt keine Dubletten. Kein Standard-Term modelliert den Fortschritt eines inkrementellen Abrufs; ow:revision trägt eine Quell-Revision, keine Zeitgrenze."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:observationCount a owl:DatatypeProperty ;
    rdfs:domain ow:Variable ;
    rdfs:range xsd:integer ;
    rdfs:label "Messpunkte"@de, "observation count"@en ;
    rdfs:comment "Anzahl der im Beobachtungs-Speicher liegenden Messpunkte dieser Größe. Weil die Werte selbst nicht im Graphen stehen (Invariante C3), ist dies die einzige per SPARQL erreichbare Aussage über den Umfang des Bestands — ohne sie wäre die Abdeckung nur über das Dateisystem sichtbar. void:triples zählt Tripel eines Datasets, nicht Punkte einer externen Reihe."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:retentionDays a owl:DatatypeProperty ;
    rdfs:domain ow:Variable ;
    rdfs:range xsd:integer ;
    rdfs:label "Aufbewahrung in Tagen"@de, "retention days"@en ;
    rdfs:comment "Aufbewahrungsdauer der erfassten Reihe in Tagen; 0 bedeutet unbegrenzt (der Default — der Zweck der Erfassung ist gerade, das zu behalten, was die Quelle verwirft). Sie steht an der Variablen und nicht als globale Einstellung, weil sich hochfrequente und seltene Größen im Volumen um Größenordnungen unterscheiden."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

#################################################################
# Kausalmodell (CAUSAL_LAYER_SPEC §5, Meilenstein C0)
#
# Die kausale Kante selbst ist FREMD und steht deshalb nicht hier:
# obo:RO_0002411 ("causally upstream of", OBO Relations Ontology)
# trägt Richtung und zeitliche Vorordnung und ist eine
# OWL-Objekteigenschaft — genau das, was ein DAG behauptet
# (Invariante C8). Geprüft und verworfen: wdt:P828/P1542 (nur
# innerhalb von Wikidata definiert, P828 zeigt rückwärts),
# prov:wasDerivedFrom (ausdrücklich keine Kausalität),
# RO_0002410 (symmetrisch, ohne Richtung).
#
# Eigen ist hier nur, was ÜBER eine Kante ausgesagt wird. Diese
# Aussagen hängen als RDF-1.2-Annotation am benannten Reifier
# (rdf:reifies + Triple Term), damit eine kausale Aussage
# zitierfähig ist, ohne dass ein Property-Graph nötig wäre (§5.3).
#################################################################

ow:CausalModel a owl:Class ;
    rdfs:subClassOf schema:CreativeWork ;
    rdfs:label "Kausalmodell"@de, "causal model"@en ;
    rdfs:comment "Ein gerichteter azyklischer Graph aus Variablen und kausalen Kanten, der eine ANNAHME über die Welt festhält (Invariante C1: Struktur ist Annahme, nicht Ergebnis) und einem Kontext zugeordnet ist. Kein Standard-Vokabular modelliert eine solche Annahmenstruktur als eigenständiges, versionierbares Werk: die OBO Relations Ontology liefert die Relation, aber kein Modell, das sie bündelt; schema:Dataset beschreibt Daten statt Annahmen; prov:Plan ist ein Handlungsplan. schema:CreativeWork ist die nächstliegende Oberklasse, weil ein Kausalmodell ein von Menschen verantwortetes Artefakt mit Autor, Titel und Änderungsdatum ist. Die Variablen des Modells hängen per schema:hasPart daran; die Kanten leben im Named Graph des Modells (graph/<u>/causal/<modelId>)."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:edgeClass a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Kantenklasse"@de, "edge class"@en ;
    rdfs:comment "Herkunftsklasse einer kausalen Kante als Annotation am benannten Reifier: 'hypothesis' (LLM oder Text), 'structural' (Geräte-Topologie, Physik), 'learned' (Struktur-Lernen aus Daten) oder 'asserted' (der Mensch hat es gesetzt). Invariante C2 verlangt diese vier disjunkten Klassen, weil eine Hypothese in der Oberfläche nie wie ein bestätigter Effekt aussehen darf. Kein Standard-Term trägt das: prov:wasAttributedTo nennt den Urheber, nicht die epistemische Klasse der Aussage, und prov:wasDerivedFrom taugt für Kausalität ausdrücklich nicht."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:temporalLag a owl:DatatypeProperty ;
    rdfs:range xsd:duration ;
    rdfs:label "Zeitversatz"@de, "temporal lag"@en ;
    rdfs:comment "Erwarteter zeitlicher Abstand zwischen Ursache und Wirkung als xsd:duration, als Annotation am Reifier der kausalen Kante (offenes Fenster geheizt → Energieverbrauch, PT15M). Er macht die temporale Zulässigkeit einer Hypothese maschinell prüfbar und bestimmt später die Lag-Spalten der Studien-Tabelle. OWL-Time (time:hasDuration) beschreibt die Dauer temporaler Entitäten; sie an einen Reifier zu hängen, machte die Aussage selbst zu einem Zeitintervall. schema:duration gilt für Ereignisse und Medien, nicht für den Versatz einer Relation."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .

ow:evidenceLevel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Evidenzstufe"@de, "evidence level"@en ;
    rdfs:comment "Belegstand einer kausalen Kante am Reifier: 'hypothesis' (nur behauptet), 'estimated' (geschätzt, aber nicht falsifiziert) oder 'refuted-clean' (Schätzung samt bestandener Refutation). Sie ist von ow:edgeClass getrennt, weil Herkunft und Belegstand unabhängig sind — eine vom Menschen gesetzte Kante bleibt unbelegt, bis eine Studie sie prüft — und sie ist die Filtergröße, mit der Invariante C5 durchgesetzt wird ('ein Effekt ohne Refutation existiert nicht'). Kein Standard-Term stuft die Belegkraft einer Aussage ab: sh:severity bewertet Validierungsbefunde, prov nennt Herkunft, nicht Geltung."@de ;
    rdfs:isDefinedBy <https://pajew-ski.github.io/open-workspace/ns/v1> .
