@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix ow:      <https://pajew-ski.github.io/open-workspace/ns/v1#> .
@prefix owsh:    <https://pajew-ski.github.io/open-workspace/ns/shapes#> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema:  <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# SHACL-Shapes für kausale Kanten (CAUSAL_LAYER_SPEC §5, C0)
#
# Sie sind der billigste der Filter aus §8 („die Symbolik richtet"):
# Typverträglichkeit, Klassenzugehörigkeit und Lag-Form lassen sich
# ohne eine einzige Schätzung prüfen. Was hier durchfällt, muss gar
# nicht erst identifiziert oder geschätzt werden.
#
# Geladen wie die Kern-Shapes nach graph/shapes; ausgewertet auf
# Anforderung über /api/graph/validate und in der Kausal-Ansicht.
# Seit C1 laufen sie zusätzlich vor jedem Schreibvorgang des DAG-Editors
# (§7.2 Stelle 1) — blockierend aber NUR bei Verstößen, die die Änderung
# neu einführt. Was per SPARQL im Graphen steht, bleibt bearbeitbar; für
# den Altbestand sagt ein Bericht mehr als ein abgelehnter Schreibvorgang.
#
# NICHT hier geprüft: Azyklizität, D-Separation, Identifizierbarkeit.
# Das ist Graphalgorithmik — SHACL kann es nicht, und es hier
# anzudeuten wäre eine Attrappe. Sie steht seit C1 im Tier-1-Kern
# (src/lib/graph/causal/{dag,dsep,identify}.ts); der Editor lehnt eine
# Kante, die einen Kreis schließt, deshalb schon beim Schreiben ab.
#################################################################

owsh:CausalModelShape a sh:NodeShape ;
    sh:targetClass ow:CausalModel ;
    sh:name "Kausalmodell"@de ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:minLength 1 ;
        sh:severity sh:Violation ;
        sh:message "Ein Kausalmodell braucht einen nicht-leeren Namen (schema:name)."@de ;
    ] ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Ein Kausalmodell braucht seine stabile Kennung (dcterms:identifier) — sie benennt seinen Named Graph."@de ;
    ] ;
    sh:property [
        sh:path schema:hasPart ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Die Variablen eines Modells (schema:hasPart) müssen IRIs sein, keine Literale."@de ;
    ] .

#################################################################
# Die Kante selbst: obo:RO_0002411 (causally upstream of)
#################################################################

owsh:CausalEdgeSubjectShape a sh:NodeShape ;
    sh:targetSubjectsOf obo:RO_0002411 ;
    sh:name "Ursache einer kausalen Kante"@de ;
    sh:property [
        sh:path obo:RO_0002411 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Eine kausale Kante muss auf eine IRI zeigen — ein Literal als Wirkung ist keine Variable."@de ;
    ] ;
    sh:property [
        # Kausale Kanten laufen zwischen Modellvariablen. Ein Knoten, der
        # (noch) keine ow:Variable ist, kann nie geschätzt werden — das
        # ist ein Modellierungsmangel, aber kein Grund, den Graphen
        # abzulehnen (Invariante C1: der Mensch verantwortet die Struktur).
        sh:path rdf:type ;
        sh:hasValue ow:Variable ;
        sh:severity sh:Warning ;
        sh:message "Ursache einer kausalen Kante ist keine ow:Variable — ohne Variablendefinition ist der Effekt später nicht schätzbar."@de ;
    ] .

owsh:CausalEdgeObjectShape a sh:NodeShape ;
    sh:targetObjectsOf obo:RO_0002411 ;
    sh:name "Wirkung einer kausalen Kante"@de ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue ow:Variable ;
        sh:severity sh:Warning ;
        sh:message "Wirkung einer kausalen Kante ist keine ow:Variable — ohne Variablendefinition ist der Effekt später nicht schätzbar."@de ;
    ] .

#################################################################
# Die Annotation am Reifier (RDF 1.2, §5.3)
#
# Ziel sind die Träger der Annotation, nicht die Kante: Ein Reifier
# ohne Klasse macht eine Kante herkunftslos, und genau das verbietet
# Invariante C2.
#################################################################

owsh:CausalEdgeClassShape a sh:NodeShape ;
    sh:targetSubjectsOf ow:edgeClass ;
    sh:name "Kantenklasse"@de ;
    sh:property [
        sh:path ow:edgeClass ;
        sh:in ( "hypothesis" "structural" "learned" "asserted" ) ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Kantenklasse muss genau eine von 'hypothesis', 'structural', 'learned' oder 'asserted' sein (Invariante C2: vier disjunkte Klassen)."@de ;
    ] ;
    sh:property [
        sh:path rdf:reifies ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Eine Kantenklasse gehört an den Reifier einer Kante (rdf:reifies), nicht an einen freistehenden Knoten."@de ;
    ] .

owsh:CausalEvidenceShape a sh:NodeShape ;
    sh:targetSubjectsOf ow:evidenceLevel ;
    sh:name "Evidenzstufe"@de ;
    sh:property [
        sh:path ow:evidenceLevel ;
        sh:in ( "hypothesis" "estimated" "refuted-clean" ) ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Evidenzstufe muss 'hypothesis', 'estimated' oder 'refuted-clean' sein — ein Effekt ohne bestandene Refutation ist kein Effekt (Invariante C5)."@de ;
    ] ;
    sh:property [
        sh:path ow:edgeClass ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Eine Kante mit Evidenzstufe braucht ihre Herkunftsklasse (ow:edgeClass) — sonst sähe eine Hypothese aus wie ein Befund."@de ;
    ] .

owsh:CausalTemporalLagShape a sh:NodeShape ;
    sh:targetSubjectsOf ow:temporalLag ;
    sh:name "Zeitversatz"@de ;
    sh:property [
        sh:path ow:temporalLag ;
        sh:datatype xsd:duration ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Der Zeitversatz einer kausalen Kante muss eine ISO-8601-Dauer als xsd:duration sein (z. B. \"PT15M\")."@de ;
    ] .

#################################################################
# Trennung Wissen/Präsentation im Kausal-Graphen (Invariante 2)
#
# Die Anordnung eines DAG ist Darstellung und wird clientseitig
# berechnet. Landete sie im Modell-Graphen, wäre ein Modell nicht mehr
# föderierbar, ohne fremde Bildschirmkoordinaten mitzuschicken. Die
# allgemeine Layout-Blacklist steht in core.ttl; hier wird zusätzlich
# der modelleigene Träger geprüft.
#################################################################

owsh:NoLayoutOnCausalModel a sh:NodeShape ;
    sh:targetClass ow:CausalModel ;
    sh:name "Kausalmodell ohne Layout"@de ;
    sh:property [
        sh:path ow:xPosition ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "Layout-Wert am Kausalmodell — die Anordnung des DAG wird dargestellt, nicht gespeichert (Invariante 2)."@de ;
    ] ;
    sh:property [
        sh:path schema:color ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "Farbwert am Kausalmodell — Präsentation gehört nach graph/<u>/presentation (Invariante 2)."@de ;
    ] .

#################################################################
# Studien, Zielgrößen und Falsifikationsversuche (§5.2/§13, C4)
#
# Diese Shapes sind kein Bericht, sondern ein Tor: Der Schreibpfad
# einer Studie validiert gegen sie, BEVOR er schreibt, und lehnt ab,
# was durchfällt (Invariante C7: „Ohne diese Angaben wird nicht
# geschrieben"). Das ist die einzige Stelle im Kausal-Layer, an der
# SHACL blockiert, ohne dass es um einen Altbestand ginge — eine
# unvollständige Studie soll gar nicht erst entstehen, weil sie
# hinterher niemand mehr rekonstruieren könnte.
#
# Die schärfste Regel steht bei ow:effectSize: Eine Effektstärke
# ohne bestandene Refutation ist ein Verstoß, nicht ein Mangel. Das
# ist Invariante C5, in SHACL geschrieben.
#################################################################

owsh:EstimandShape a sh:NodeShape ;
    sh:targetClass ow:Estimand ;
    sh:name "Zielgröße"@de ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Eine Zielgröße braucht ihre stabile Kennung (dcterms:identifier)."@de ;
    ] ;
    sh:property [
        sh:path ow:treatment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Eine Zielgröße braucht genau eine Behandlung (ow:treatment) als IRI."@de ;
    ] ;
    sh:property [
        sh:path ow:outcome ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Eine Zielgröße braucht genau eine Wirkung (ow:outcome) als IRI."@de ;
    ] ;
    sh:property [
        sh:path ow:seed ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:severity sh:Violation ;
        sh:message "Ohne gesetzten Startwert (ow:seed) wäre kein Lauf reproduzierbar (Invariante C7)."@de ;
    ] .

owsh:CausalStudyShape a sh:NodeShape ;
    sh:targetClass ow:CausalStudy ;
    sh:name "Kausalstudie"@de ;
    sh:property [
        sh:path ow:studyVerdict ;
        sh:in ( "not-identifiable" "not-estimable" "refuted" "passed" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Eine Studie braucht genau ein Urteil: 'not-identifiable', 'not-estimable', 'refuted' oder 'passed'."@de ;
    ] ;
    sh:property [
        sh:path ow:modelRevision ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:severity sh:Violation ;
        sh:message "Eine Studie muss die Revision des Modells nennen, auf das sie sich beruft — sonst gehört die Zahl zu keiner Annahme (Invariante C7)."@de ;
    ] ;
    sh:property [
        sh:path ow:seed ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:severity sh:Violation ;
        sh:message "Eine Studie muss ihren gesetzten Startwert (ow:seed) nennen (Invariante C7)."@de ;
    ] ;
    sh:property [
        sh:path schema:softwareVersion ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Eine Studie muss die Softwareversion nennen, mit der sie gerechnet wurde (Invariante C7)."@de ;
    ] ;
    sh:property [
        sh:path prov:generatedAtTime ;
        sh:minCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message "Eine Studie braucht ihren Zeitpunkt (prov:generatedAtTime)."@de ;
    ] ;
    sh:property [
        sh:path ow:treatment ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Eine Studie muss die Behandlung nennen, deren Wirkung sie untersucht hat."@de ;
    ] ;
    sh:property [
        sh:path ow:outcome ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Eine Studie muss die Wirkung nennen, die sie untersucht hat."@de ;
    ] .

owsh:RefutationShape a sh:NodeShape ;
    sh:targetClass ow:Refutation ;
    sh:name "Falsifikationsversuch"@de ;
    sh:property [
        sh:path ow:refutationMethod ;
        sh:in ( "placebo" "random-common-cause" "subset" "negative-control" "implied-independence" "e-value" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Ein Falsifikationsversuch muss sein Verfahren nennen (ow:refutationMethod)."@de ;
    ] ;
    sh:property [
        sh:path ow:refutationVerdict ;
        sh:in ( "passed" "failed" "inconclusive" "informative" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Ein Falsifikationsversuch muss sein Verdikt nennen: 'passed', 'failed', 'inconclusive' oder 'informative'."@de ;
    ] .

owsh:AdjustmentSetShape a sh:NodeShape ;
    sh:targetClass ow:AdjustmentSet ;
    sh:name "Adjustierungsmenge"@de ;
    sh:property [
        sh:path ow:adjustedFor ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Adjustiert wird über Variablen, also über IRIs — ein Literal ist keine Störgröße."@de ;
    ] .

#################################################################
# Invariante C5 als Shape: ein Effekt ohne bestandene Refutation
# ist ein Verstoß, kein Mangel.
#################################################################

owsh:CausalEffectShape a sh:NodeShape ;
    sh:targetSubjectsOf ow:effectSize ;
    sh:name "Geschätzter Effekt"@de ;
    sh:property [
        sh:path ow:effectSize ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Eine Effektstärke ist genau eine Dezimalzahl."@de ;
    ] ;
    sh:property [
        sh:path ow:ciLow ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "Ein Effekt ohne Konfidenzintervall ist Scheinpräzision — ow:ciLow fehlt."@de ;
    ] ;
    sh:property [
        sh:path ow:ciHigh ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "Ein Effekt ohne Konfidenzintervall ist Scheinpräzision — ow:ciHigh fehlt."@de ;
    ] ;
    sh:property [
        sh:path ow:refutationPassed ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:severity sh:Violation ;
        sh:message "Ein Effekt ohne bestandene Refutation existiert nicht (Invariante C5): ow:refutationPassed muss vorhanden und true sein."@de ;
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Ein Effekt muss auf die Studie zeigen, aus der er stammt (prov:wasGeneratedBy)."@de ;
    ] .

#################################################################
# Vorschläge und ihre Herkunft (§8, Meilenstein C6)
#
# Der Vorschlag selbst ist eine kausale Kante und wird deshalb schon
# von den Shapes oben geprüft (Klasse, Evidenzstufe, Lag-Form). Was
# hier dazukommt, ist genau das, was §8 zusätzlich verlangt:
#
#  - ein Urteil der symbolischen Filter — ohne es hätte ein Vorschlag
#    den Studien-Pfad ungeprüft erreichen können, und die Abnahme von
#    C6 sagt, dass das nicht passieren darf;
#  - eine Zuschreibung „auf Modell und Prompt-Version". Sie ist Pflicht
#    und nicht Zierde: Ein Vorschlag ohne Agenten ist nicht mehr
#    zuzuordnen, sobald jemand die Modellwahl ändert, und dann ist auch
#    der Quellenvergleich aus §8 wertlos.
#
# Der Agent wird über den Pfad geprüft (sh:node) und NICHT über
# sh:targetClass prov:SoftwareAgent: Diese Klasse tragen auch die
# Connector-Instanzen (ow:Connector ⊑ prov:SoftwareAgent), und die
# haben weder Prompt-Version noch Vorschlagsquelle.
#################################################################

owsh:CausalHypothesisShape a sh:NodeShape ;
    sh:targetSubjectsOf ow:hypothesisVerdict ;
    sh:name "Vorschlag einer kausalen Kante"@de ;
    sh:property [
        sh:path ow:hypothesisVerdict ;
        sh:in ( "accepted" "open" "rejected" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Ein Vorschlag braucht genau ein Urteil der Filter: 'accepted', 'open' oder 'rejected'."@de ;
    ] ;
    sh:property [
        sh:path rdf:reifies ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Ein Urteil gehört an den Reifier einer kausalen Kante (rdf:reifies), nicht an einen freistehenden Knoten."@de ;
    ] ;
    sh:property [
        sh:path schema:isPartOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Ein Vorschlag muss das Kausalmodell nennen, gegen dessen DAG er geprüft wurde (schema:isPartOf) — ohne Modell ist ein Urteil über Kreise und Identifizierbarkeit sinnlos."@de ;
    ] ;
    sh:property [
        sh:path prov:generatedAtTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message "Ein Vorschlag braucht seinen Zeitpunkt (prov:generatedAtTime)."@de ;
    ] ;
    sh:property [
        sh:path prov:wasAttributedTo ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Ein Vorschlag ohne Urheber ist Hörensagen ohne Absender (§8: Zuschreibung auf Modell und Prompt-Version)."@de ;
        sh:node owsh:ProposalAgentShape ;
    ] .

owsh:ProposalAgentShape a sh:NodeShape ;
    sh:name "Vorschlagende Quelle"@de ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Die vorschlagende Quelle braucht ihre Kennung (dcterms:identifier: llm, topology, wikidata) — der Quellenvergleich gruppiert nach ihr."@de ;
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:minLength 1 ;
        sh:severity sh:Violation ;
        sh:message "Die vorschlagende Quelle muss sagen, WAS vorgeschlagen hat — das benutzte Sprachmodell oder das Verfahren (schema:name)."@de ;
    ] ;
    sh:property [
        sh:path schema:softwareVersion ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Die vorschlagende Quelle muss ihre Prompt- bzw. Verfahrensversion nennen (schema:softwareVersion) — sonst ist später nicht feststellbar, ob ein schlechter Vorschlag am Modell oder an der Frage lag."@de ;
    ] .

owsh:HypothesisFilterShape a sh:NodeShape ;
    sh:targetSubjectsOf ow:filterRejectedBy ;
    sh:name "Verwerfender Filter"@de ;
    sh:property [
        sh:path ow:filterRejectedBy ;
        sh:in ( "cycle" "shacl" "temporal" "topology" ) ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Der verwerfende Filter muss einer der vier harten sein: 'cycle', 'shacl', 'temporal' oder 'topology'."@de ;
    ] ;
    sh:property [
        sh:path ow:hypothesisVerdict ;
        sh:hasValue "rejected" ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Ein verwerfender Filter steht nur an einem verworfenen Vorschlag — sonst behauptete der Graph, etwas sei zugleich zulässig und durchgefallen."@de ;
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:minCount 1 ;
        sh:minLength 1 ;
        sh:severity sh:Violation ;
        sh:message "Ein verworfener Vorschlag braucht seine Begründung im Klartext (schema:description) — \"ungültig\" ist keine Auskunft."@de ;
    ] .
