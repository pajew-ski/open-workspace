<urn:ow:14b46c31-2026-4d79-9fe6-4516cf791ea6:u/default/doc/sys-doc-004> <https://schema.org/about> <urn:ow:14b46c31-2026-4d79-9fe6-4516cf791ea6:u/default/tag/architecture> <urn:ow:14b46c31-2026-4d79-9fe6-4516cf791ea6:graph/u/default/workspace> .
