# Runtime `server` — Umgebung für deploy/server/docker-compose.yml (M12).
# Kopieren nach deploy/server/.env und ausfüllen.

# Image. Leer lassen, um lokal aus dem einen Dockerfile zu bauen:
#   docker compose -f deploy/server/docker-compose.yml build
OW_IMAGE=ghcr.io/pajew-ski/open-workspace:latest

# Öffentlicher Hostname (Zertifikat + OIDC-Redirect) und ACME-Kontakt.
OW_PUBLIC_HOST=workspace.example.org
OW_TLS_EMAIL=admin@example.org

# Ziel hinter Caddy: mit OIDC der oauth2-proxy, ohne ihn direkt die App.
OW_UPSTREAM=oauth2-proxy:4180
# OW_UPSTREAM=app:3000

# Identität. `proxy-header` vertraut den Headern des oauth2-proxy;
# `single-user` ist der ehrliche Einzelnutzer-Betrieb ohne Anmeldung;
# `oidc-bearer` prüft Zugriffs-Token selbst gegen die JWKS des Providers.
OW_AUTH_MODE=proxy-header

# Unterpfad, falls die App nicht an der Wurzel liegt (z. B. /workspace).
OW_BASE_PATH=

# OIDC (Profil `oidc`). Cookie-Secret: 32 zufällige Bytes, base64.
#   openssl rand -base64 32 | tr -- '+/' '-_'
OIDC_ISSUER_URL=https://id.example.org/realms/main
OIDC_CLIENT_ID=open-workspace
OIDC_CLIENT_SECRET=
OIDC_COOKIE_SECRET=

# Nur für OW_AUTH_MODE=oidc-bearer (API-Clients mit eigenem Token):
# OW_OIDC_ISSUER=https://id.example.org/realms/main
# OW_OIDC_AUDIENCE=open-workspace
# OW_OIDC_JWKS_URL=https://id.example.org/realms/main/protocol/openid-connect/certs

# Zugänge des MCP-Servers (SPEC §7.6) — siehe .env.example im Repo-Wurzel.
OW_MCP_TOKENS=
